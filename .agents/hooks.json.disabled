{
  "format-on-save": {
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "command": "powershell -ExecutionPolicy Bypass -File \"C:\\Users\\Eduardo\\Downloads\\smart-home-hub\\.agents\\hooks\\format-on-save.ps1\"",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "cascade-guard": {
    "PreToolUse": [
      {
        "matcher": "replace_file_content|multi_replace_file_content",
        "hooks": [
          {
            "command": "powershell -ExecutionPolicy Bypass -File \"C:\\Users\\Eduardo\\Downloads\\smart-home-hub\\.agents\\hooks\\guard-cascade-removal.ps1\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}