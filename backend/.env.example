# Copie este arquivo para backend/.env e preencha os valores reais.
# NUNCA commite o .env real — só este .example, sem segredos.

# --- PostgreSQL / TimescaleDB (usado pelo docker-compose e pela connection string do EF Core) ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# --- Firebase Admin (validação de token JWT no middleware da API) ---
# Web API Key do projeto no Firebase Console > Configurações do projeto > Geral
FIREBASE__WEBAPIKEY=

# --- Spotify Web API (integração de mídia) ---
# Criadas em https://developer.spotify.com/dashboard
Spotify__ClientId=
Spotify__ClientSecret=
# Deve bater exatamente com uma Redirect URI cadastrada no dashboard do Spotify
Spotify__RedirectUri=
