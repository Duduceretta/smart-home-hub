# Copie este arquivo para frontend/.env.local e preencha os valores reais.
# NUNCA commite o .env.local real — só este .example, sem segredos.

# --- Firebase (Web SDK) ---
# Firebase Console > Configurações do projeto > Geral > Seus apps > Config do SDK
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- API do backend (opcional) ---
# Se omitido, o cliente usa http://localhost:5252/api como padrão (src/core/lib/signalr.ts)
VITE_API_URL=http://localhost:5252/api
