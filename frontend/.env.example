# Smart Home Hub — Frontend Environment Configuration Template
# Copy this file to .env.local or .env to configure local development settings.

# Backend API Origin
# URL base para requisições REST do Axios (api.client.ts) e conexão SignalR Hub (signalr.ts).
# Default local: http://localhost:5252/api
VITE_API_URL=http://localhost:5252/api

# Firebase Authentication Configuration
# Configurações do projeto Firebase para autenticação de usuários (firebase.ts).
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
